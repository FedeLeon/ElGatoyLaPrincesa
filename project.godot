; El gato y la Princesa - first playable slice
config_version=5

[application]
config/name="El gato y la Princesa"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/borderless=false
window/size/resizable=true
window/stretch/mode="canvas_items"

[autoload]
GameSettings="*res://scripts/game_settings.gd"

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventJoypadButton,"button_index":0)]}
attack={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70),Object(InputEventJoypadButton,"button_index":2)]}
dodge={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32),Object(InputEventJoypadButton,"button_index":1)]}
block={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81),Object(InputEventJoypadButton,"button_index":4)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305),Object(InputEventJoypadButton,"button_index":6)]}
look_left={"deadzone":0.2,"events":[Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0)]}
look_right={"deadzone":0.2,"events":[Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0)]}
look_up={"deadzone":0.2,"events":[Object(InputEventJoypadMotion,"axis":3,"axis_value":-1.0)]}
look_down={"deadzone":0.2,"events":[Object(InputEventJoypadMotion,"axis":3,"axis_value":1.0)]}
bow_toggle={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":67),Object(InputEventJoypadButton,"button_index":3)]}
bow_aim={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":2),Object(InputEventJoypadMotion,"axis":4,"axis_value":1.0)]}
bow_fire={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1),Object(InputEventJoypadMotion,"axis":5,"axis_value":1.0)]}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.176, 0.231, 0.235, 1)
